<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi Kasir & Database Nur Fikri</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</head>
<body class="bg-slate-100 font-sans text-slate-800">

    <!-- Modal Login -->
    <div id="login-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6 border border-slate-100">
            <div class="text-center mb-6">
                <h1 class="text-2xl font-bold text-indigo-900">Nur Fikri Kasir</h1>
                <p class="text-xs text-slate-500 mt-1">Silakan login untuk mengakses sistem</p>
            </div>
            <form onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Username</label>
                    <input type="text" id="login-username" required class="w-full px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Password</label>
                    <input type="password" id="login-password" required class="w-full px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div id="login-error" class="hidden text-xs text-rose-600 font-bold">Username atau password salah!</div>
                <button type="submit" class="w-full py-2.5 bg-indigo-700 hover:bg-indigo-800 text-white font-bold rounded-lg text-sm transition">Login</button>
            </form>
        </div>
    </div>

    <!-- Main Content -->
    <div id="app-content" class="hidden min-h-screen flex flex-col">
        <!-- Header -->
        <header class="bg-indigo-900 text-white px-6 py-4 flex justify-between items-center shadow-lg">
            <div class="flex items-center gap-3">
                <span class="text-xl font-black tracking-wider">NUR FIKRI</span>
                <span class="text-xs bg-indigo-800 px-2.5 py-1 rounded-full text-indigo-200">Sistem Keuangan</span>
            </div>
            <div class="flex items-center gap-4 text-xs">
                <span>Halo, <b id="user-display-name">Admin</b></span>
                <button onclick="handleLogout()" class="bg-rose-600 hover:bg-rose-700 px-3 py-1.5 rounded font-bold transition">Logout</button>
            </div>
        </header>

        <!-- Navigation -->
        <div class="bg-indigo-800 px-6 py-2 flex gap-2 border-t border-indigo-700">
            <button id="tab-btn-dashboard" onclick="switchTab('dashboard')" class="px-3 py-1.5 text-xs font-bold rounded-lg transition-all bg-white text-indigo-800 shadow">Dashboard & Rekap</button>
            <button id="tab-btn-students" onclick="switchTab('students')" class="px-3 py-1.5 text-xs font-bold rounded-lg transition-all text-indigo-100 hover:text-white">Database Siswa</button>
            <button id="tab-btn-input" onclick="switchTab('input')" class="px-3 py-1.5 text-xs font-bold rounded-lg transition-all text-indigo-100 hover:text-white">+ Buat Invoice</button>
        </div>

        <!-- Body Page -->
        <main class="p-6 flex-1 max-w-7xl w-full mx-auto">
            
            <!-- PAGE: Dashboard -->
            <div id="page-dashboard" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                        <div class="text-xs font-bold text-slate-400">TOTAL PEMBAYARAN</div>
                        <div id="stat-total-income" class="text-xl font-extrabold text-emerald-600 mt-1">Rp 0</div>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                        <div class="text-xs font-bold text-slate-400">TOTAL INVOICE</div>
                        <div id="stat-total-count" class="text-xl font-extrabold text-slate-800 mt-1">0</div>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                        <div class="text-xs font-bold text-slate-400">INVOICE LUNAS</div>
                        <div id="stat-paid-count" class="text-xl font-extrabold text-indigo-600 mt-1">0</div>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                        <div class="text-xs font-bold text-slate-400">BELUM LUNAS</div>
                        <div id="stat-unpaid-count" class="text-xl font-extrabold text-amber-600 mt-1">0</div>
                        <div id="stat-unpaid-amount" class="text-[10px] text-amber-700 mt-0.5">Pending: Rp 0</div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                        <h2 class="font-bold text-slate-800 text-sm">Riwayat & Rekap Invoice</h2>
                        <input type="text" id="dash-search" oninput="renderDashboardTable()" placeholder="Cari nama / no invoice..." class="px-3 py-1.5 text-xs border rounded-lg w-64 outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-100 text-slate-600 font-bold border-b">
                                <tr>
                                    <th class="p-3">NO INVOICE</th>
                                    <th class="p-3">TANGGAL</th>
                                    <th class="p-3">SISWA</th>
                                    <th class="p-3">ITEM</th>
                                    <th class="p-3 text-right">TOTAL</th>
                                    <th class="p-3 text-center">STATUS</th>
                                    <th class="p-3">PETUGAS</th>
                                    <th class="p-3 text-center">AKSI</th>
                                </tr>
                            </thead>
                            <tbody id="dash-table-body" class="divide-y divide-slate-100"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- PAGE: Database Siswa -->
            <div id="page-students" class="hidden space-y-6">
                <!-- Sync Google Sheets Box -->
                <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 space-y-3">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">🔗</span>
                        <h3 class="font-bold text-sm text-slate-800">Integrasi Google Sheets (Pendaftaran Google Form)</h3>
                    </div>
                    <p class="text-xs text-slate-500">Tautkan link Google Sheets hasil respon pendaftaran Google Form untuk sync otomatis data siswa secara masal.</p>
                    <div class="flex gap-2">
                        <input type="text" id="gsheet-url" value="https://docs.google.com/spreadsheets/d/1UMVMkeXpEP9fGhQFCnse1_Cdhw8po2TAR82eN-u9Y7Q/edit?usp=sharing" class="flex-1 px-3 py-2 text-xs border rounded-lg font-mono outline-none focus:ring-2 focus:ring-indigo-500">
                        <button onclick="syncGoogleSheetsData()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg transition flex items-center gap-1">
                            🔄 Sync Data dari Google Sheets Sekarang
                        </button>
                    </div>
                    <div id="gsheet-status" class="text-xs italic text-slate-400"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Form Input Manual Siswa -->
                    <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 space-y-4">
                        <h3 class="font-bold text-sm text-slate-800 border-b pb-2">+ Tambah Siswa Baru (Manual)</h3>
                        <form id="add-student-form" onsubmit="handleAddNewStudent(event)" class="space-y-3 text-xs">
                            <div>
                                <label class="block font-bold text-slate-600 mb-1">NIS Siswa</label>
                                <input type="text" id="new-nis" required placeholder="Contoh: NF-202601" class="w-full px-3 py-1.5 border rounded-lg">
                            </div>
                            <div>
                                <label class="block font-bold text-slate-600 mb-1">Nama Lengkap</label>
                                <input type="text" id="new-nama" required placeholder="Nama Siswa" class="w-full px-3 py-1.5 border rounded-lg">
                            </div>
                            <div>
                                <label class="block font-bold text-slate-600 mb-1">Program Bimbel</label>
                                <select id="new-program" class="w-full px-3 py-1.5 border rounded-lg bg-white">
                                    <option value="Bimbel Reguler">Bimbel Reguler</option>
                                    <option value="Bimbel Intensif">Bimbel Intensif</option>
                                    <option value="Privat">Privat</option>
                                </select>
                            </div>
                            <div>
                                <label class="block font-bold text-slate-600 mb-1">Cabang</label>
                                <input type="text" id="new-cabang" value="Nur Fikri Ciamis" class="w-full px-3 py-1.5 border rounded-lg">
                            </div>
                            <div>
                                <label class="block font-bold text-slate-600 mb-1">No WhatsApp Orang Tua</label>
                                <input type="text" id="new-wa" placeholder="08xxxxxxxxxx" class="w-full px-3 py-1.5 border rounded-lg">
                            </div>
                            <button type="submit" class="w-full py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg transition">Simpan Siswa</button>
                        </form>
                        <div class="border-t pt-3">
                            <label class="block font-bold text-slate-600 mb-1 text-xs">Atau Import via Excel (.xlsx)</label>
                            <input type="file" id="excel-file" accept=".xlsx, .xls" class="block w-full text-xs text-slate-500 file:mr-2 file:py-1 file:px-2 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700">
                            <div id="upload-info" class="text-[10px] text-emerald-600 mt-1"></div>
                        </div>
                    </div>

                    <!-- Tabel Data Siswa -->
                    <div class="md:col-span-2 bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                            <div>
                                <h2 class="font-bold text-slate-800 text-sm">Database Siswa Registered</h2>
                                <p class="text-[10px] text-slate-400">Total: <span id="stat-student-total">0</span> Siswa | Aktif: <span id="stat-student-active">0</span></p>
                            </div>
                            <input type="text" id="student-search" oninput="renderStudentsTable()" placeholder="Cari nama/NIS..." class="px-3 py-1.5 text-xs border rounded-lg w-48 outline-none focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-100 text-slate-600 font-bold border-b">
                                    <tr>
                                        <th class="p-3">NIS</th>
                                        <th class="p-3">NAMA SISWA</th>
                                        <th class="p-3">PROGRAM</th>
                                        <th class="p-3">CABANG</th>
                                        <th class="p-3">WA ORANG TUA</th>
                                        <th class="p-3 text-center">STATUS</th>
                                        <th class="p-3 text-center">AKSI</th>
                                    </tr>
                                </thead>
                                <tbody id="student-table-body" class="divide-y divide-slate-100"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PAGE: Input Invoice -->
            <div id="page-input" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Form Input Left -->
                <div class="lg:col-span-7 bg-white p-5 rounded-xl shadow-sm border border-slate-200 space-y-4">
                    <h3 class="font-bold text-sm text-slate-800 border-b pb-2">Input Rincian Transaksi Invoice</h3>
                    
                    <!-- Cari Siswa -->
                    <div class="relative">
                        <label class="block text-xs font-bold text-slate-600 mb-1">Cari / Pilih Siswa</label>
                        <input type="text" id="search-student" placeholder="Ketik nama siswa..." class="w-full px-3 py-2 text-xs border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                        <div id="search-results" class="hidden absolute top-full left-0 right-0 bg-white border rounded-b-lg shadow-lg z-20 max-h-48 overflow-y-auto"></div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <div>
                            <label class="block font-bold text-slate-600 mb-1">NIS</label>
                            <input type="text" id="student-nis" readonly class="w-full px-3 py-1.5 bg-slate-50 border rounded-lg font-mono">
                        </div>
                        <div>
                            <label class="block font-bold text-slate-600 mb-1">Cabang</label>
                            <input type="text" id="student-branch" readonly class="w-full px-3 py-1.5 bg-slate-50 border rounded-lg">
                        </div>
                        <div>
                            <label class="block font-bold text-slate-600 mb-1">Program</label>
                            <input type="text" id="student-program" readonly class="w-full px-3 py-1.5 bg-slate-50 border rounded-lg">
                        </div>
                        <div>
                            <label class="block font-bold text-slate-600 mb-1">No WA Orang Tua</label>
                            <input type="text" id="student-wa" class="w-full px-3 py-1.5 border rounded-lg font-mono">
                        </div>
                    </div>

                    <hr>

                    <!-- Tambah Item -->
                    <div class="space-y-3 bg-slate-50 p-3 rounded-lg border border-slate-100 text-xs">
                        <div class="font-bold text-slate-700">Tambah Item Pembayaran</div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Jenis Item</label>
                                <select id="item-type" onchange="toggleItemInputs()" class="w-full px-2 py-1.5 border rounded bg-white">
                                    <option value="SPP">Biaya SPP</option>
                                    <option value="Modul">Buku Modul / Akses</option>
                                    <option value="Kaos">Kaos / Seragam</option>
                                    <option value="Pendaftaran">Biaya Pendaftaran</option>
                                </select>
                            </div>
                            <div id="box-spp-month">
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Pilih Bulan SPP</label>
                                <select id="item-month" class="w-full px-2 py-1.5 border rounded bg-white">
                                    <option value="Januari">Januari</option>
                                    <option value="Februari">Februari</option>
                                    <option value="Maret">Maret</option>
                                    <option value="April">April</option>
                                    <option value="Mei">Mei</option>
                                    <option value="Juni">Juni</option>
                                    <option value="Juli">Juli</option>
                                    <option value="Agustus">Agustus</option>
                                    <option value="September">September</option>
                                    <option value="Oktober">Oktober</option>
                                    <option value="November">November</option>
                                    <option value="Desember">Desember</option>
                                </select>
                            </div>
                        </div>

                        <div id="box-program" class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Tahun</label>
                                <input type="number" id="item-year" value="2026" class="w-full px-2 py-1.5 border rounded">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Opsi Program</label>
                                <select id="item-program-opt" class="w-full px-2 py-1.5 border rounded bg-white">
                                    <option value="Reguler">Reguler</option>
                                    <option value="Intensif">Intensif</option>
                                    <option value="Privat">Privat</option>
                                </select>
                            </div>
                        </div>

                        <div id="box-book-type" class="hidden">
                            <label class="block text-[10px] font-bold text-slate-500 mb-1">Opsi Buku / Modul</label>
                            <select id="item-book-opt" onchange="checkCustomBookOption()" class="w-full px-2 py-1.5 border rounded bg-white">
                                <option value="Modul Semester 1">Modul Semester 1</option>
                                <option value="Modul Semester 2">Modul Semester 2</option>
                                <option value="Buku Soal UTBK/SNBT">Buku Soal UTBK/SNBT</option>
                                <option value="Lainnya">Lainnya...</option>
                            </select>
                        </div>

                        <div id="box-custom-desc" class="hidden">
                            <label class="block text-[10px] font-bold text-slate-500 mb-1">Keterangan Tambahan</label>
                            <input type="text" id="item-custom-text" placeholder="Detail item..." class="w-full px-2 py-1.5 border rounded">
                        </div>

                        <div class="grid grid-cols-3 gap-2">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Harga (Rp)</label>
                                <input type="number" id="item-price" value="250000" class="w-full px-2 py-1.5 border rounded font-mono">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 mb-1">Jumlah (Qty)</label>
                                <input type="number" id="item-qty" value="1" min="1" class="w-full px-2 py-1.5 border rounded font-mono">
                            </div>
                            <div class="flex items-end">
                                <button onclick="addItemToInvoice()" class="w-full py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded transition text-xs">+ Tambah</button>
                            </div>
                        </div>
                    </div>

                    <!-- List Items Added -->
                    <div class="border rounded-lg p-3 text-xs">
                        <div class="font-bold text-slate-700 mb-2">Daftar Item Terpilih:</div>
                        <div id="added-items-list" class="space-y-1 divide-y">
                            <p class="text-slate-400 italic text-center py-2">Belum ada item ditambahkan.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <div>
                            <label class="block font-bold text-slate-600 mb-1">Diskon / Potongan (Rp)</label>
                            <input type="number" id="inv-discount" value="0" class="w-full px-3 py-1.5 border rounded-lg font-mono">
                        </div>
                        <div>
                            <label class="block font-bold text-slate-600 mb-1">Status Pembayaran</label>
                            <select id="inv-status-input" class="w-full px-3 py-1.5 border rounded-lg bg-white font-bold">
                                <option value="Lunas">Lunas</option>
                                <option value="Belum Lunas">Belum Lunas</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Preview Invoice Right -->
                <div class="lg:col-span-5 space-y-4">
                    <div id="invoice-preview-card" class="bg-white p-6 rounded-xl shadow-md border border-slate-200 text-xs text-slate-800 space-y-4">
                        <div class="flex justify-between items-start border-b pb-4">
                            <div>
                                <h2 class="text-lg font-black text-indigo-900 tracking-wider">NUR FIKRI</h2>
                                <p class="text-[10px] text-slate-500">Bimbingan Belajar & Konsultasi Pendidikan</p>
                            </div>
                            <div class="text-right font-mono">
                                <div id="prev-inv-num" class="font-bold text-slate-800">INV/2026/0000</div>
                                <div id="prev-inv-date" class="text-[10px] text-slate-400">01/01/2026</div>
                            </div>
                        </div>

                        <div class="bg-slate-50 p-3 rounded-lg border border-slate-100 space-y-1">
                            <div class="flex justify-between"><span class="text-slate-400">Siswa:</span> <span id="prev-name" class="font-bold text-slate-800">- Pilih Siswa -</span></div>
                            <div class="flex justify-between"><span class="text-slate-400">NIS:</span> <span id="prev-nis" class="font-mono">-</span></div>
                            <div class="flex justify-between"><span class="text-slate-400">Cabang:</span> <span id="prev-branch">-</span></div>
                            <div class="flex justify-between"><span class="text-slate-400">Program:</span> <span id="prev-program">-</span></div>
                            <div class="flex justify-between"><span class="text-slate-400">No WA:</span> <span id="prev-wa" class="font-mono">-</span></div>
                        </div>

                        <div>
                            <table class="w-full text-left">
                                <thead>
                                    <tr class="border-b text-slate-400 font-bold">
                                        <th class="py-1">Deskripsi</th>
                                        <th class="py-1 text-center">Qty</th>
                                        <th class="py-1 text-right">Harga</th>
                                        <th class="py-1 text-right">Total</th>
                                    </tr>
                                </thead>
                                <tbody id="prev-items-body" class="divide-y divide-slate-100">
                                    <tr><td colspan="4" class="py-3 text-center text-slate-400 italic">Belum ada item ditambahkan.</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="border-t pt-3 space-y-1.5 font-mono">
                            <div id="row-discount" class="flex justify-between text-rose-600 hidden">
                                <span>Potongan / Diskon:</span>
                                <span id="prev-discount">- Rp 0</span>
                            </div>
                            <div class="flex justify-between text-sm font-bold text-slate-900 border-t pt-2">
                                <span>TOTAL BAYAR:</span>
                                <span id="prev-total" class="text-indigo-900 text-base font-black">Rp 0</span>
                            </div>
                        </div>

                        <div class="text-[10px] text-slate-400 border-t pt-3 flex justify-between items-center">
                            <span>Petugas: <b id="prev-admin-name">Admin</b></span>
                            <span>Terima kasih atas kepercayaannya.</span>
                        </div>
                    </div>

                    <div class="flex gap-2">
                        <button onclick="saveInvoiceToDashboard()" class="flex-1 py-2.5 bg-indigo-700 hover:bg-indigo-800 text-white font-bold rounded-lg text-xs transition shadow">
                            💾 Simpan Ke Rekap
                        </button>
                        <button onclick="sendWhatsApp()" class="py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-xs transition flex items-center gap-1 shadow">
                            💬 Kirim WA
                        </button>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- Hidden Input Date & Inv Generator Needed JS -->
    <input type="hidden" id="inv-number">
    <input type="hidden" id="inv-date">

    <!-- JavaScript Application Logic -->
    <script>
    const ACCOUNTS = {
        'admin1': { name: 'Admin Keuangan 1', pass: 'password123' },
        'admin2': { name: 'Admin Keuangan 2', pass: 'password123' }
    };

    let currentUser = JSON.parse(sessionStorage.getItem('nf_user')) || null;
    let studentsDatabase = JSON.parse(localStorage.getItem('nf_students_db')) || [];
    let currentInvoiceItems = [];
    let invoiceList = JSON.parse(localStorage.getItem('nf_invoices')) || [];

    window.addEventListener('DOMContentLoaded', () => {
        if (currentUser) {
            initApp();
        } else {
            document.getElementById('login-modal').classList.remove('hidden');
            document.getElementById('app-content').classList.add('hidden');
        }
    });

    function handleLogin(e) {
        e.preventDefault();
        const u = document.getElementById('login-username').value.trim();
        const p = document.getElementById('login-password').value.trim();
        const err = document.getElementById('login-error');

        if (ACCOUNTS[u] && ACCOUNTS[u].pass === p) {
            currentUser = { username: u, name: ACCOUNTS[u].name };
            sessionStorage.setItem('nf_user', JSON.stringify(currentUser));
            err.classList.add('hidden');
            initApp();
        } else {
            err.classList.remove('hidden');
