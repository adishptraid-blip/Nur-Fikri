    function sendWhatsApp() {
        let wa = document.getElementById('student-wa').value.replace(/[^0-9]/g, '');
        if (!wa) return alert('Masukkan nomor WA!');
        if (wa.startsWith('0')) wa = '62' + wa.slice(1);

        const name = document.getElementById('prev-name').innerText;
        const invNum = document.getElementById('prev-inv-num').innerText;
        const total = document.getElementById('prev-total').innerText;
        const itemsText = currentInvoiceItems.map(i => `- ${i.title} (${i.qty}x): ${formatRupiah(i.subtotal)}`).join('\n');

        const text = `Halo Bapak/Ibu Orang Tua dari *${name}*,\n\nBerikut ringkasan tagihan bimbingan belajar Nur Fikri:\n\n📌 *No Invoice:* ${invNum}\n\n*Rincian Item:*\n${itemsText}\n\n💰 *Total Pembayaran:* ${total}\n\nPembayaran dapat dilakukan via transfer bank/kasir Nur Fikri. Terima kasih.`;
        window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
    }

    function sendWaFromList(id) {
        const inv = invoiceList.find(i => i.id === id);
        if (!inv) return;
        let wa = inv.wa.replace(/[^0-9]/g, '');
        if (wa.startsWith('0')) wa = '62' + wa.slice(1);

        const itemsText = inv.items.map(i => `- ${i.title} (${i.qty}x): ${formatRupiah(i.subtotal)}`).join('\n');
        const text = `Halo Bapak/Ibu Orang Tua dari *${inv.name}*,\n\nBerikut ringkasan tagihan bimbingan belajar Nur Fikri:\n\n📌 *No Invoice:* ${inv.invNum}\n\n*Rincian Item:*\n${itemsText}\n\n💰 *Total Pembayaran:* ${formatRupiah(inv.total)}\n\nPembayaran dapat dilakukan via transfer bank/kasir Nur Fikri. Terima kasih.`;
        window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank');
    }
    </script>
