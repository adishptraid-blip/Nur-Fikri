    // Fetch Google Sheets Data (Bypassing CORS via Google Visualization API)
    function syncGoogleSheetsData() {
        const urlInput = document.getElementById('gsheet-url').value.trim();
        const statusDiv = document.getElementById('gsheet-status');
        
        statusDiv.className = "mt-2 text-xs font-medium italic text-amber-600";
        statusDiv.innerText = "⏳ Sedang mengambil data dari Google Sheets...";

        // Ekstrak Sheet ID dari Link
        const match = urlInput.match(/\/d\/([a-zA-Z0-9-_]+)/);
        if (!match || !match[1]) {
            statusDiv.className = "mt-2 text-xs font-medium italic text-rose-600";
            statusDiv.innerText = "⚠️ Link Google Sheets tidak valid. Pastikan format link benar!";
            return;
        }

        const sheetId = match[1];
        
        // Menggunakan Google Visualization Query API (Bypass CORS Error)
        const gvizUrl = `https://docs.google.com/spreadsheets/d/${sheetId}/gviz/tq?tqx=out:json`;

        // Hapus script callback lama jika ada
        const oldScript = document.getElementById('gviz-script');
        if (oldScript) oldScript.remove();

        // Buat callback global untuk menerima data dari Google
        window.handleGvizResponse = function(response) {
            try {
                if (response.isError()) {
                    throw new Error("Gagal membaca Google Sheets. Pastikan akses spreadsheet sudah diset 'Siapa saja yang memiliki link / Anyone with link'");
                }

                const dataTable = response.getDataTable();
                const numRows = dataTable.getNumberOfRows();
                const fetchedStudents = [];

                for (let r = 0; r < numRows; r++) {
                    // Mengambil nilai per kolom
                    const nis = dataTable.getValue(r, 0) ? String(dataTable.getValue(r, 0)).trim() : `NF-${1000 + r}`;
                    const nama = dataTable.getValue(r, 1) ? String(dataTable.getValue(r, 1)).trim() : '';
                    const program = dataTable.getValue(r, 2) ? String(dataTable.getValue(r, 2)).trim() : 'Bimbel Reguler';
                    const cabang = dataTable.getValue(r, 3) ? String(dataTable.getValue(r, 3)).trim() : 'Nur Fikri Ciamis';
                    const wa = dataTable.getValue(r, 4) ? String(dataTable.getValue(r, 4)).trim() : '';

                    if (nama) {
                        fetchedStudents.push({ nis, nama, program, cabang, wa, status: 'Aktif' });
                    }
                }

                if (fetchedStudents.length > 0) {
                    fetchedStudents.forEach(fs => {
                        const idx = studentsDatabase.findIndex(s => s.nis.toLowerCase() === fs.nis.toLowerCase());
                        if (idx !== -1) {
                            studentsDatabase[idx] = fs; // update
                        } else {
                            studentsDatabase.push(fs); // add new
                        }
                    });

                    localStorage.setItem('nf_students_db', JSON.stringify(studentsDatabase));
                    statusDiv.className = "mt-2 text-xs font-medium italic text-emerald-600";
                    statusDiv.innerText = `✅ Berhasil sinkronisasi ${fetchedStudents.length} siswa dari Google Sheets!`;
                    renderStudentsTable();
                } else {
                    statusDiv.className = "mt-2 text-xs font-medium italic text-amber-600";
                    statusDiv.innerText = "⚠️ Google Sheets terhubung, tapi tidak ada data nama siswa yang ditemukan.";
                }
            } catch (err) {
                statusDiv.className = "mt-2 text-xs font-medium italic text-rose-600";
                statusDiv.innerText = "⚠️ " + err.message;
            }
        };

        // Panggil API Google Sheets via JSONP Injection
        const script = document.createElement('script');
        script.id = 'gviz-script';
        script.src = `${gvizUrl}&responseHandler=handleGvizResponse`;
        script.onerror = function() {
            statusDiv.className = "mt-2 text-xs font-medium italic text-rose-600";
            statusDiv.innerText = "⚠️ Gagal terhubung! Pastikan koneksi internet aktif dan link Google Sheets diset ke publik (Anyone with link).";
        };
        document.body.appendChild(script);
    }

    // Excel Reader
    document.addEventListener('DOMContentLoaded', () => {
        const excelInput = document.getElementById('excel-file');
        if (excelInput) {
            excelInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = function(e) {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const sheetName = workbook.SheetNames.find(s => s.includes('Database Siswa')) || workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[sheetName];
                    const json = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

                    let countAdded = 0;
                    for (let i = 2; i < json.length; i++) {
                        const row = json[i];
                        if (row && row[1] && row[2]) {
                            const newS = {
                                nis: String(row[1]).trim(),
                                nama: String(row[2]).trim(),
                                cabang: row[12] ? String(row[12]).trim() : 'Nur Fikri Ciamis',
                                program: row[13] ? String(row[13]).trim() : 'Bimbel Reguler',
                                wa: row[16] ? String(row[16]).trim() : '',
                                status: 'Aktif'
                            };
                            if (!studentsDatabase.some(s => s.nis === newS.nis)) {
                                studentsDatabase.push(newS);
                                countAdded++;
                            }
                        }
                    }

                    localStorage.setItem('nf_students_db', JSON.stringify(studentsDatabase));
                    document.getElementById('upload-info').innerHTML = `✅ Berhasil mengimpor ${countAdded} data siswa baru dari Excel.`;
                    renderStudentsTable();
                };
                reader.readAsArrayBuffer(file);
            });
        }

        const searchInput = document.getElementById('search-student');
        const resultsDiv = document.getElementById('search-results');

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase().trim();
                resultsDiv.innerHTML = '';

                if (query.length < 1 || studentsDatabase.length === 0) {
                    resultsDiv.classList.add('hidden');
                    return;
                }

                const filtered = studentsDatabase.filter(s => 
                    s.nama.toLowerCase().includes(query) || s.nis.toLowerCase().includes(query)
                ).slice(0, 10);

                if (filtered.length === 0) {
                    resultsDiv.classList.add('hidden');
                    return;
                }

                filtered.forEach(s => {
                    const item = document.createElement('div');
                    item.className = 'p-2.5 hover:bg-indigo-50 cursor-pointer border-b border-slate-100 text-xs transition';
                    item.innerHTML = `<div class="font-bold text-slate-800">${s.nama}</div><div class="text-[10px] text-slate-500 font-mono">NIS: ${s.nis} | Program: ${s.program} (${s.cabang})</div>`;
                    item.onclick = function() {
                        selectStudentForInvoice(s);
                    };
                    resultsDiv.appendChild(item);
                });

                resultsDiv.classList.remove('hidden');
            });
        }

        const invDate = document.getElementById('inv-date');
        const invNum = document.getElementById('inv-number');
        if (invDate) invDate.valueAsDate = new Date();
        if (invNum) invNum.value = 'INV/' + new Date().getFullYear() + '/' + Math.floor(1000 + Math.random() * 9000);

        ['search-student', 'inv-number', 'inv-date', 'inv-discount', 'student-wa'].forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('input', updateInvoicePreview);
                el.addEventListener('change', updateInvoicePreview);
            }
        });
    });

