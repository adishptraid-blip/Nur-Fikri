            branch: document.getElementById('student-branch').value,
            program: document.getElementById('student-program').value,
            wa: document.getElementById('student-wa').value,
            items: [...currentInvoiceItems],
            discount: discount,
            total: subtotal - discount,
            status: document.getElementById('inv-status-input').value,
            createdByName: currentUser ? currentUser.name : 'Admin'
        };

        invoiceList.unshift(invData);
        localStorage.setItem('nf_invoices', JSON.stringify(invoiceList));

        alert('Invoice ' + invData.invNum + ' berhasil disimpan oleh ' + invData.createdByName + '!');
