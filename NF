    function formatRupiah(val) {
        return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
    }

    function updateInvoicePreview() {
        const name = document.getElementById('search-student').value || '- Pilih Siswa -';
        const nis = document.getElementById('student-nis').value || '-';
        const branch = document.getElementById('student-branch').value || 'Nur Fikri Ciamis';
        const program = document.getElementById('student-program').value || '-';
        const wa = document.getElementById('student-wa').value || '-';
        const invNum = document.getElementById('inv-number').value;
        const invDate = document.getElementById('inv-date').value;
        const discount = parseFloat(document.getElementById('inv-discount').value) || 0;

        document.getElementById('prev-name').innerText = name;
        document.getElementById('prev-nis').innerText = nis;
        document.getElementById('prev-branch').innerText = branch;
        document.getElementById('prev-program').innerText = program;
        document.getElementById('prev-wa').innerText = wa;
        document.getElementById('prev-inv-num').innerText = invNum;
        document.getElementById('prev-inv-date').innerText = invDate ? new Date(invDate).toLocaleDateString('id-ID') : '-';

        const tbody = document.getElementById('prev-items-body');
        tbody.innerHTML = '';

        let grandTotal = 0;

        if (currentInvoiceItems.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="py-3 text-center text-slate-400 italic">Belum ada item ditambahkan.</td></tr>`;
        } else {
            currentInvoiceItems.forEach(i => {
                grandTotal += i.subtotal;
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="py-2 font-medium text-slate-800">${i.title}</td>
                    <td class="py-2 text-center font-mono">${i.qty}</td>
                    <td class="py-2 text-right font-mono">${formatRupiah(i.price)}</td>
                    <td class="py-2 text-right font-mono font-bold text-slate-800">${formatRupiah(i.subtotal)}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        const finalTotal = grandTotal - discount;

        if (discount > 0) {
            document.getElementById('row-discount').classList.remove('hidden');
            document.getElementById('prev-discount').innerText = '- ' + formatRupiah(discount);
        } else {
            document.getElementById('row-discount').classList.add('hidden');
        }
        document.getElementById('prev-total').innerText = formatRupiah(finalTotal < 0 ? 0 : finalTotal);
    }

    function saveInvoiceToDashboard() {
        const name = document.getElementById('search-student').value;
        if (!name) return alert('Silakan pilih nama siswa!');
        if (currentInvoiceItems.length === 0) return alert('Tambahkan minimal 1 item pembayaran!');

        const discount = parseFloat(document.getElementById('inv-discount').value) || 0;
        const subtotal = currentInvoiceItems.reduce((acc, curr) => acc + curr.subtotal, 0);

        const invData = {
            id: Date.now(),
            invNum: document.getElementById('inv-number').value,
            date: document.getElementById('inv-date').value,
