    function addItemToInvoice() {
        const type = document.getElementById('item-type').value;
        const price = parseFloat(document.getElementById('item-price').value) || 0;
        const qty = parseInt(document.getElementById('item-qty').value) || 1;
        let title = '';

        if (type === 'SPP') {
            const prog = document.getElementById('item-program-opt').value;
            const month = document.getElementById('item-month').value;
            const year = document.getElementById('item-year').value;
            title = `SPP ${prog} - Bulan ${month} ${year}`;
        } else if (type === 'Modul') {
            const prog = document.getElementById('item-program-opt').value;
            const bookOpt = document.getElementById('item-book-opt').value;
            const customText = document.getElementById('item-custom-text').value;
            
            const bookTitle = bookOpt === 'Lainnya' ? (customText || 'Buku Modul') : bookOpt;
            title = `Modul (${bookTitle}) - ${prog}`;
        } else if (type === 'Kaos') {
            const detail = document.getElementById('item-custom-text').value || 'All Size';
            title = `Kaos / Seragam Nur Fikri (${detail})`;
        } else {
            const detail = document.getElementById('item-custom-text').value || 'Biaya Registrasi';
            title = `${type} - ${detail}`;
        }

        currentInvoiceItems.push({
            id: Date.now(),
            title: title,
            price: price,
            qty: qty,
            subtotal: price * qty
        });

        renderAddedItemsList();
        updateInvoicePreview();
    }

    function removeItem(id) {
        currentInvoiceItems = currentInvoiceItems.filter(i => i.id !== id);
        renderAddedItemsList();
        updateInvoicePreview();
    }

    function renderAddedItemsList() {
        const listDiv = document.getElementById('added-items-list');
        if (currentInvoiceItems.length === 0) {
            listDiv.innerHTML = `<p class="text-slate-400 italic text-center py-2">Belum ada item ditambahkan.</p>`;
            return;
        }

        listDiv.innerHTML = '';
        currentInvoiceItems.forEach(item => {
            const div = document.createElement('div');
            div.className = 'flex justify-between items-center py-1 font-medium';
            div.innerHTML = `
                <div>
                    <span class="font-bold text-slate-800">${item.title}</span>
                    <span class="text-[10px] text-slate-500 font-mono"> (${item.qty}x @ ${formatRupiah(item.price)})</span>
